# Copy to .env.local (development) or .env (the VPS) and fill in. Never commit the real file.

# --- Site ------------------------------------------------------------------
# Public address, used in emails and to decide whether the admin cookie is Secure (https).
SITE_URL=https://www.smartbuilttech.com

# --- MySQL / MariaDB -------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sbt
DB_PASSWORD=change-me
DB_NAME=sbt_careers

# --- Admin area (/sys-ops): one shared login --------------------------------
ADMIN_USERNAME=admin
# Either a plain password...
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# ...or, better, a hash made with: npm run admin:hash -- "your password"
# (when ADMIN_PASSWORD_HASH is set, ADMIN_PASSWORD is ignored)
# ADMIN_PASSWORD_HASH=
# At least 32 random characters. Signs the login cookie. Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Abuse protection ------------------------------------------------------
# Applications allowed per IP address per hour (default 10).
# APPLY_RATE_LIMIT_PER_HOUR=10

# --- CV uploads ------------------------------------------------------------
# Folder on the server (outside public/) where CVs are saved. Back it up with the database.
UPLOAD_DIR=./storage/cv

# --- Pictures uploaded in the admin area (blog and event covers) -----------
# Folder on the server (outside public/) for uploaded pictures. Back it up with the database.
MEDIA_DIR=./storage/media

# --- Email (nodemailer, SMTP) ----------------------------------------------
# If SMTP_HOST is empty, applications are still saved and emails are skipped.
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Set to true only for a private relay with a self-signed certificate.
# SMTP_INSECURE_TLS=false
MAIL_FROM="Smart Built Technologies Careers <careers@smartbuilttech.com>"
# Where new-application emails go (comma-separate for several people)
HR_EMAIL=careers@smartbuilttech.com
